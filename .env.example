# Preview and local testing read the copied sheet. Leave production Netlify
# variables on the live sheet until that test is accepted.

# Apps Script web app deployed as Execute as me / Anyone.
# https://script.google.com/macros/s/.../exec
# It must not contain /a/macros/varsitytutors.com/
SHEET_WEBAPP_URL=
SHEET_PUBLISH_SECRET=
WORKING_TAB_NAME=Working Tab

# Where the script published the workbook. The test copy uses the test file.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_PATH=data/workbook-test.json

# yes rewrites tutor match reasons with gpt-4o-mini. Otherwise the desk shows subject matches.
AI_ENABLED=

# Optional Slack note for the 30-day NAT check.
SLACK_WEBHOOK_URL=

# Local tests only. Ignored on Netlify.
# WORKBOOK_FILE=
# COURSEOPS_DEV_AUTH=preview

# Operations dashboard. Vite exposes only VITE_ variables to the browser.
# Do not put Starburst, service-role, or other secrets in a VITE_ variable.

# Supabase anon (publishable) key. Manual Refresh reads public.courses and public.instructors.
# Grant the anon role SELECT only. This app does not create the tables.
#
# courses (
#   id text primary key,
#   name text not null,
#   subject text not null,
#   rate_type text not null,          -- Test Prep | Academic | Professional Certification
#   product_type text not null,       -- Livestream | Small Group
#   start_date date not null,
#   end_date date not null,
#   days_of_week text[] not null,     -- Mon, Tue, Wed, Thu, Fri, Sat, Sun
#   time text not null,               -- 19:00:00
#   duration numeric not null,        -- hours per meeting
#   rate numeric not null,
#   instructor_name text,
#   instructor_email text,
#   status text not null,             -- Available | Waiting for response | Assigned | Ended | Cancelled
#   working_on_it boolean not null default false,
#   client_url text,
#   catalog_url text,
#   internal_notes text,
#   note_to_courses_team text
# )
#
# instructors (
#   email text primary key,
#   name text not null,
#   qualified_subjects text[] not null,
#   taught_subjects text[] not null default '{}',
#   greenlit boolean not null default false,
#   historical_teaching_count integer not null default 0
# )
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Published Google Sheet CSV. Optional Refresh fallback. The Import CSV button does not need this.
VITE_GOOGLE_SHEET_CSV_URL=

# Starburst Galaxy stays on the server. The function reads these with Netlify.env.get.
# Prefer bronze, silver, or gold. Default cluster is adhoc. Do not point this at raw_sb_* or raw_redshift.
# The proxy returns "not configured" and runs no SQL until a courses table is verified.
# STARBURST_HOST=
# STARBURST_USER=
# STARBURST_PASSWORD=
# STARBURST_CATALOG=
# STARBURST_SCHEMA=
# STARBURST_COURSES_TABLE=
# STARBURST_INSTRUCTORS_TABLE=
# STARBURST_CLUSTER=adhoc

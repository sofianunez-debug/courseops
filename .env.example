# --- Google Sheets ---
# The ID from the sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_ID=

# Tab names inside the workbook. Preview mode always uses the canonical names.
WORKING_TAB_NAME=Working
INSTRUCTORS_TAB_NAME=Instructors
SUBS_TAB_NAME=Subs
LOG_TAB_NAME=Activity Log

# --- Google service account (Sheets + Gmail) ---
# One-line JSON for a service account that can edit the staffing sheet.
#   node -e "console.log(JSON.stringify(require('./service-account.json')))"
# Gmail send-as also needs domain-wide delegation for the gmail.send scope.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Mailbox the service account impersonates.
GROUP_TUTORS_EMAIL=grouptutors@varsitytutors.com

# Optional Slack incoming webhook. Failures and the daily NAT check post here
# when this is set and the app is in live mode.
SLACK_WEBHOOK_URL=

# Shared key sent by the dashboard. Local preview accepts "preview" when this
# is unset. Set a long random value before deploying.
DASHBOARD_ACCESS_KEY=

# preview | live | (unset = live when Sheet ID and service account JSON exist)
# DATA_MODE=preview
